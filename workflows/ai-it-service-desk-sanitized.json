    {
      "parameters": {
        "jsCode": "\nconst ticket = $('Classify Ticket (JavaScript)').first().json;\n\nconst rawAI = $input.first().json.output;\n\nconst ai = typeof rawAI === 'string'\n  ? JSON.parse(rawAI)\n  : rawAI;\n\nif (!ai || !['Low', 'Medium', 'High'].includes(ai.aiPriority)) {\n  throw new Error('AI output is missing or has invalid priority');\n}\n\n// Never downgrade the original rule-based priority\nconst levels = { Low: 1, Medium: 2, High: 3 };\n\nconst finalPriority =\n  levels[ai.aiPriority] > levels[ticket.priority]\n    ? ai.aiPriority\n    : ticket.priority;\n\nreturn [{\n  json: {\n    requestId: ticket.requestId,\n    ticketId: ticket.ticketId,\n    requester: ticket.requesterForSheet ?? ticket.requester,\n    summary: ticket.summaryForSheet ?? ticket.summary,\n    priority: finalPriority,\n    category: ticket.category,\n    receivedAt: ticket.receivedAt,\n    status: ticket.status,\n    note: ticket.note,\n\n    aiCategory: ai.aiCategory,\n    aiPriority: ai.aiPriority,\n    aiCause: ai.aiCause,\n    aiSuggestedAction: ai.aiSuggestedAction\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
