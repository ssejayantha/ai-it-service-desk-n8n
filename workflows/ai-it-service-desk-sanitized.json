    {
      "parameters": {
        "jsCode": "\nreturn $input.all().map((item) => {\n  const body = item.json.body ?? item.json;\n\n  if (!body || typeof body !== 'object' || Array.isArray(body)) {\n    return {\n      json: {\n        valid: false,\n        status: 'rejected',\n        error: 'Invalid request body'\n      }\n    };\n  }\n\n  const requestId = typeof body.requestId === 'string'\n    ? body.requestId.trim() : '';\n\n  const requester = typeof body.requester === 'string'\n    ? body.requester.trim() : '';\n\n  const summary = typeof body.summary === 'string'\n    ? body.summary.trim() : '';\n\n  // Request ID must be stable across retries.\n  if (!/^[A-Za-z0-9][A-Za-z0-9_-]{7,63}$/.test(requestId)) {\n    return {\n      json: {\n        valid: false,\n        status: 'rejected',\n        error: 'A valid requestId (8-64 characters) is required'\n      }\n    };\n  }\n\n  // Basic requester email validation.\n  if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(requester)) {\n    return {\n      json: {\n        valid: false,\n        status: 'rejected',\n        error: 'A valid requester email is required'\n      }\n    };\n  }\n\n  if (!summary || summary.length > 500) {\n    return {\n      json: {\n        valid: false,\n        status: 'rejected',\n        error: 'Summary must contain 1-500 characters'\n      }\n    };\n  }\n\n  const lower = summary.toLowerCase();\n  let priority = 'Low';\n  let category = 'General IT support';\n\n  if (/outage|all staff|all users|phishing|ransomware|malware|breach|hacked|server down|system down/.test(lower)) {\n    priority = 'High';\n    category = /phishing|ransomware|malware|breach|hacked/.test(lower)\n      ? 'Security'\n      : 'Service outage';\n  } else if (/login|password|mfa|access|email|outlook|vpn|network|wifi|printer|slow/.test(lower)) {\n    priority = 'Medium';\n    category = 'Account or device support';\n  }\n\n  // Prevent spreadsheet formula interpretation.\n  const safeForSheet = (value) =>\n    /^[=+\\-@]/.test(value) ? \"'\" + value : value;\n\n  return {\n    json: {\n      valid: true,\n      status: 'classified',\n      requestId,\n      ticketId: `DEMO-${requestId}`,\n      requester,\n      requesterForSheet: safeForSheet(requester),\n      summary,\n      summaryForSheet: safeForSheet(summary),\n      priority,\n      category,\n      receivedAt: new Date().toISOString(),\n      note: 'IT Service Desk training project'\n    }\n  };\n});\n"
      },
